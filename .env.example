# Copy to .env for local development. Do not commit .env.

# dev | prod module. Local default is config.settings.dev (see manage.py).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=

# Comma-separated. Production refuses to boot when this is empty.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public origin used in canonical URLs, the sitemap, and password-reset links.
SITE_URL=http://127.0.0.1:8000

# Optional. When unset, dev uses SQLite at data/db.sqlite3.
# Production uses DATABASE_URL when set, otherwise SQLite at data/db.sqlite3.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/djstratagem
# DATABASE_SSL_REQUIRE=true

# Mail. Dev prints messages to the console unless you set a backend.
# Production uses SMTP when EMAIL_HOST is set and EMAIL_BACKEND is empty.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=hello@djstratageminc.com
SERVER_EMAIL=hello@djstratageminc.com

# Inbox for contact-form notifications. Leave empty to store inquiries without emailing.
CONTACT_TO_EMAIL=hello@djstratageminc.com

# Production (Fly) defaults these to 1 inside config.settings.prod.
# Leave them at 0 for local HTTP. HSTS in production is 7 days and is not preloaded.
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_SSL=0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Gunicorn inside the container. The image defaults to 1 worker and 2 threads
# for a 512 MB Machine. Override here for a larger host.
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_THREADS=2

# SQLite and uploads. Unset locally (data/db.sqlite3 and media/).
# On Fly these are /data and /data/media, on the volume. See DEPLOY.md.
# DJANGO_DATA_DIR=
# DJANGO_MEDIA_ROOT=
# DJANGO_SQLITE_PATH=

# Preview videos. Leave all five unset to keep media/videos on local disk
# (or the Fly volume). Set them together to serve videos from Cloudflare R2.
# See DEPLOY.md. Do not set only some of them: the app refuses to boot.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=djstratagem-media
# R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.djstratageminc.com

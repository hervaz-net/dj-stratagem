# Copy to .env for local development. Do not commit .env.

# dev | prod module. Local default is config.settings.dev (see manage.py).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=

# Comma-separated. Production refuses to boot when this is empty.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public origin used in canonical URLs, the sitemap, and password-reset links.
SITE_URL=http://127.0.0.1:8000

# Optional. When unset, dev uses SQLite at data/db.sqlite3.
# Production uses DATABASE_URL when set, otherwise SQLite at data/db.sqlite3.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/djstratagem
# DATABASE_SSL_REQUIRE=true

# Mail. Dev prints messages to the console unless you set a backend.
# Production uses SMTP when EMAIL_HOST is set and EMAIL_BACKEND is empty.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=hello@djstratageminc.com
SERVER_EMAIL=hello@djstratageminc.com

# Inbox for contact-form notifications. Leave empty to store inquiries without emailing.
CONTACT_TO_EMAIL=hello@djstratageminc.com

# Set to 1 when TLS terminates at a reverse proxy.
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_SSL=0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Gunicorn inside the container reads PORT.
PORT=8000
WEB_CONCURRENCY=2

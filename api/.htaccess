# Never serve these as files. config.php holds database credentials.
<FilesMatch "^(config\.php|config\.example.php|bootstrap\.php|ops\.php|schema\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.php$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
    Header always set X-Content-Type-Options "nosniff"
  </IfModule>
</FilesMatch>

Options -Indexes
DirectoryIndex index.php not-found.php
ErrorDocument 404 /api/index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^not-found\.php$ - [L]
  RewriteRule ^health\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

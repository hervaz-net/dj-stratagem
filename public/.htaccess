# Namecheap LiteSpeed uses CloudLinux alt-php, not EasyApache.
<FilesMatch "[.]php$">
  SetHandler application/x-httpd-alt-php81___lsphp
</FilesMatch>
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php81___lsphp .php .php8 .phtml
</IfModule>
AddType application/manifest+json .webmanifest

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_HOST} ^www[.]djstratageminc[.]com$ [NC]
  RewriteRule ^ https://djstratageminc.com%{REQUEST_URI} [R=301,L]

  # The root health probe remains available even if a partial API tree ships.
  RewriteRule ^api/health(\.php)?/?$ /health.php [L,PT]
  RewriteRule ^api/?$ /api/index.php [L]
  RewriteRule ^send-demo[.]php$ /contact.php [L]
  RewriteRule ^favicon[.]ico$ /favicon.svg [L]
  RewriteRule ^apple-touch-icon(-precomposed)?[.]png$ /favicon.svg [L]
  RewriteRule ^sitemap$ /sitemap.xml [R=301,L]

  # Keep legacy public URLs pointed at the new route tree.
  RewriteRule ^(blog|changelog)/?$ /resources/$1/ [R=301,L]
  RewriteRule ^blog/.+$ /resources/blog/ [R=301,L]
  RewriteRule ^changelog/.+$ /resources/changelog/ [R=301,L]
  RewriteRule ^(register|signup|sign-up|trial|start|get-started)/?$ /join/ [R=301,L]
  RewriteRule ^(signin|sign-in|log-in|account|app)/?$ /login/ [R=301,L]
  RewriteRule ^(forgot|reset|password)/?$ /forgot-password/ [R=301,L]
  RewriteRule ^(profile|settings|admin)/?$ /login/ [R=301,L]
  RewriteRule ^dashboard/.+$ /dashboard/ [R=301,L]
  RewriteRule ^(credit|credits|credit-application)/?$ /capital/ [R=301,L]
  RewriteRule ^companies/(capital|studio|workforce|fleet)/?$ /$1/ [R=301,L]
  RewriteRule ^companies/?$ / [R=301,L]
  RewriteRule ^(marketplace|contractors|distributors|suppliers)/?$ /exchange/ [R=301,L]
  RewriteRule ^exchange/(marketplace|contractors|distributors|suppliers)/?$ /exchange/ [R=301,L]
  RewriteRule ^(supply/catalog|catalog|shop)/?$ /exchange/ [R=301,L]
  RewriteRule ^supplier/?$ /exchange/ [R=301,L]
  RewriteRule ^(project|bids|bid)/?$ /projects/ [R=301,L]
  RewriteRule ^projects/[^/]+/?$ /projects/ [R=301,L]
  RewriteRule ^construction-projects/[^/]+/[^/]+/?$ /projects/ [R=301,L]
  RewriteRule ^exchange/projects(?:/[^/]+)?/?$ /projects/ [R=301,L]
  RewriteRule ^exchange/construction-projects/[^/]+/[^/]+/?$ /projects/ [R=301,L]
  RewriteRule ^exchange/(privacy-policy|privacy)/?$ /privacy/ [R=301,L]
  RewriteRule ^exchange/(terms-of-service|terms|tos|legal|eula)/?$ /terms/ [R=301,L]
  RewriteRule ^exchange/brand(?:-guidelines)?/?$ /about/ [R=301,L]
  RewriteRule ^exchange/(about|about-us|company|team)/?$ /about/ [R=301,L]
  RewriteRule ^exchange/(contact|contact-us)/?$ /contact/ [R=301,L]
  RewriteRule ^exchange/pricing/?$ /pricing/ [R=301,L]
  RewriteRule ^exchange/(features|product|services|how-it-works|howitworks)/?$ /platform/ [R=301,L]
  RewriteRule ^exchange/partners/?$ /solutions/ [R=301,L]
  RewriteRule ^exchange/dashboard(?:/.*)?$ /login/ [R=301,L]
  RewriteRule ^(help|support|faq|faqs|docs|resource)/?$ /resources/guides/ [R=301,L]
  RewriteRule ^(features|product|services|how-it-works|howitworks)/?$ /platform/ [R=301,L]
  RewriteRule ^(partners)/?$ /solutions/ [R=301,L]
  RewriteRule ^(contact-us|demo|book|book-demo|request-demo|careers|jobs)/?$ /contact/ [R=301,L]
  RewriteRule ^(about-us|company|team|status|security|investors|accessibility|a11y|brand|brand-guidelines)/?$ /about/ [R=301,L]
  RewriteRule ^(privacy-policy|cookies|cookie|cookie-policy|gdpr|unsubscribe)/?$ /privacy/ [R=301,L]
  RewriteRule ^(terms-of-service|tos|legal|eula)/?$ /terms/ [R=301,L]
  RewriteRule ^(feed|rss|atom|news|press)/?$ /resources/changelog/ [R=301,L]
  RewriteRule ^equipment/?$ /fleet/ [R=301,L]
  RewriteRule ^fleet-cards/?$ /fleet-cards.html [L]
  RewriteRule ^signage/?$ /signage.html [L]
  RewriteRule ^receipts/?$ /receipts.html [L]
  RewriteRule ^manifest[.]json$ /manifest.webmanifest [L]
  RewriteRule ^spa[.]php$ / [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(robots[.]txt|sitemap[.]xml|manifest[.]webmanifest|manifest[.]json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^[A-Za-z0-9._-]+[.](js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Namecheap LiteSpeed on server247 uses CloudLinux alt-php, not EasyApache.
# Live responses advertise PHP/8.1.34. The previous ea-php82___lsphp handler
# is not installed on this account, so LiteSpeed started PHP then returned
# an empty HTML 500 for every .php request (contact form, /api/me.php, login).
# Use the CloudLinux lsphp MIME type (three underscores). The short
# application/x-httpd-alt-php81 name is not registered on this host.
# Keep the handler in source: rsync --delete wipes the MultiPHP-injected block.
<FilesMatch "[.]php$">
  SetHandler application/x-httpd-alt-php81___lsphp
</FilesMatch>
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php81___lsphp .php .php8 .phtml
  AddType application/manifest+json .webmanifest
</IfModule>
AddType application/manifest+json .webmanifest

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_HOST} ^www[.]djstratageminc[.]com$ [NC]
  RewriteRule ^ https://djstratageminc.com%{REQUEST_URI} [R=301,L]

  # /api/health.php must not depend on the file existing under public_html/api.
  # Live trees have been missing that file; LiteSpeed then emits its HTML 404
  # before later aliases run because /api/ is a real directory. Always send
  # the probe to the working root /health.php first. PT forces handler rerun.
  RewriteRule ^api/health(\.php)?/?$ /health.php [L,PT]

  # Extensionless app routes that share a stem with a real file. MultiViews
  # maps /privacy and /terms onto privacy.html and terms.html, and the -f
  # pass below would then stop the rewrite. Those URLs dropped the site
  # chrome and kept the Exchange share card. Stamp them before that pass.
  RewriteRule ^privacy$ /spa.php [L]
  RewriteRule ^terms$ /spa.php [L]
  RewriteRule ^brand$ /spa.php [L]
  RewriteRule ^fleet$ /spa.php [L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /fleet is the Stratagem Fleet page. Vehicle photos used to live in
  # public/fleet/, which made LiteSpeed list the directory instead of the SPA.
  # Photos now live in /media/fleet/. Keep this rule so a leftover directory
  # cannot bring the listing back. Serve spa.php so the share card is Fleet,
  # not the parent homepage. Canonicalize the slash first so /fleet/
  # does not duplicate /fleet.
  RewriteRule ^fleet/$ /fleet [R=301,L]

  # Each company has its own top-level site; old /companies/<slug> links move.
  RewriteRule ^companies/(capital|studio|workforce|fleet)/?$ /$1 [R=301,L]

  # /manifest.json must never become index.html. Live public_html has shipped
  # without the file, and LiteSpeed DOCUMENT_ROOT is unreliable on this account,
  # so do not gate the alias on a filesystem probe.
  RewriteRule ^manifest[.]json$ manifest.webmanifest [L]
  RewriteRule ^credit$ /exchange/dashboard/settings [R=301,L]
  RewriteRule ^credits$ /exchange/dashboard/settings [R=301,L]
  RewriteRule ^credit-application$ /exchange/dashboard/settings [R=301,L]
  # Stratagem Exchange moved under /exchange when D&J Stratagem, Inc. returned
  # to the root. Keep its old top-level URLs working.
  RewriteRule ^(marketplace|contractors|distributors|suppliers)$ /exchange/$1 [R=301,L]

  # Partial public_html trees have been missing /api/*.php and health.php.
  # Never let those URLs become the marketing SPA — JSON or a PHP 404 only.
  # /api (no slash) 301s to /api/ because it is a directory. Serve the
  # index from the parent too, so a host that skips the subdirectory rule
  # still returns the API descriptor instead of the marketing SPA.
  RewriteRule ^api/?$ api/index.php [L]
  RewriteRule ^api/ api/index.php [L]
  RewriteRule [.]php$ contact.php [L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Legal and brand URLs are app routes. The printable HTML stays at
  # /privacy.html, /terms.html, and /brand-guidelines.html for the iframe
  # and for direct downloads. Do not map the extensionless URLs onto those
  # files: that dropped the site chrome and stamped Stratagem Exchange on
  # the parent company's share cards.
  RewriteRule ^blog$ /changelog [R=301,L]
  RewriteRule ^blog/ /changelog [R=301,L]

  RewriteRule ^signin$ /login [R=301,L]
  RewriteRule ^sign-in$ /login [R=301,L]
  RewriteRule ^log-in$ /login [R=301,L]
  RewriteRule ^account$ /login [R=301,L]
  RewriteRule ^credit$ /exchange/dashboard/settings [R=301,L]
  RewriteRule ^credits$ /exchange/dashboard/settings [R=301,L]
  RewriteRule ^credit-application$ /exchange/dashboard/settings [R=301,L]
  RewriteRule ^signup$ /register [R=301,L]
  RewriteRule ^sign-up$ /register [R=301,L]
  RewriteRule ^trial$ /register [R=301,L]
  RewriteRule ^start$ /register [R=301,L]
  RewriteRule ^get-started$ /register [R=301,L]
  RewriteRule ^join$ /register [R=301,L]
  RewriteRule ^forgot$ /forgot-password [R=301,L]
  RewriteRule ^reset-password$ /forgot-password [R=301,L]
  RewriteRule ^reset$ /forgot-password [R=301,L]
  RewriteRule ^password$ /forgot-password [R=301,L]
  RewriteRule ^project$ /projects [R=301,L]
  RewriteRule ^bids$ /projects [R=301,L]
  RewriteRule ^bid$ /projects [R=301,L]
  RewriteRule ^resources$ /changelog [R=301,L]
  RewriteRule ^resource$ /changelog [R=301,L]
  RewriteRule ^profile$ /dashboard/settings [R=301,L]
  RewriteRule ^settings$ /dashboard/settings [R=301,L]
  RewriteRule ^about-us$ /about [R=301,L]
  RewriteRule ^company$ /about [R=301,L]
  RewriteRule ^team$ /about [R=301,L]
  RewriteRule ^status$ /about [R=301,L]
  RewriteRule ^security$ /about [R=301,L]
  RewriteRule ^investors$ /about [R=301,L]
  RewriteRule ^partners$ /solutions [R=301,L]
  RewriteRule ^accessibility$ /about [R=301,L]
  RewriteRule ^a11y$ /about [R=301,L]
  RewriteRule ^contact-us$ /contact [R=301,L]
  RewriteRule ^help$ /contact [R=301,L]
  RewriteRule ^support$ /contact [R=301,L]
  RewriteRule ^demo$ /contact [R=301,L]
  RewriteRule ^faq$ /contact [R=301,L]
  RewriteRule ^faqs$ /contact [R=301,L]
  RewriteRule ^book$ /contact [R=301,L]
  RewriteRule ^book-demo$ /contact [R=301,L]
  RewriteRule ^request-demo$ /contact [R=301,L]
  RewriteRule ^careers$ /contact [R=301,L]
  RewriteRule ^jobs$ /contact [R=301,L]
  RewriteRule ^docs$ /changelog [R=301,L]
  RewriteRule ^home$ / [R=301,L]
  RewriteRule ^features$ /platform [R=301,L]
  RewriteRule ^product$ /platform [R=301,L]
  RewriteRule ^services$ /platform [R=301,L]
  RewriteRule ^how-it-works$ /platform [R=301,L]
  RewriteRule ^howitworks$ /platform [R=301,L]
  RewriteRule ^news$ /changelog [R=302,L]
  RewriteRule ^press$ /changelog [R=302,L]
  RewriteRule ^privacy-policy$ /privacy [R=301,L]
  RewriteRule ^cookies$ /privacy [R=301,L]
  RewriteRule ^cookie$ /privacy [R=301,L]
  RewriteRule ^cookie-policy$ /privacy [R=301,L]
  RewriteRule ^gdpr$ /privacy [R=301,L]
  RewriteRule ^unsubscribe$ /privacy [R=301,L]
  RewriteRule ^terms-of-service$ /terms [R=301,L]
  RewriteRule ^tos$ /terms [R=301,L]
  RewriteRule ^legal$ /terms [R=301,L]
  RewriteRule ^eula$ /terms [R=301,L]
  RewriteRule ^brand-guidelines$ /brand [R=301,L]
  # Printable sheets are real files. Do not send them through the SPA:
  # a stale bundle renders an empty marketing shell and never sets a title.
  RewriteRule ^fleet-cards$ /fleet-cards.html [L]
  RewriteRule ^marketing/fleet-cards$ /fleet-cards.html [L]
  RewriteRule ^signage$ /signage.html [L]
  RewriteRule ^marketing/signage$ /signage.html [L]
  RewriteRule ^receipts$ /receipts.html [L]
  RewriteRule ^marketing/receipts$ /receipts.html [L]
  # /supply is the parent site's page again; the marketplace lives at
  # /exchange/marketplace (Stratagem Exchange subsidiary).
  RewriteRule ^supply/catalog/?$ /exchange/marketplace [R=301,L]
  RewriteRule ^supply/catalog/ /exchange/marketplace [R=301,L]
  RewriteRule ^catalog/?$ /exchange/marketplace [R=301,L]
  RewriteRule ^catalog/ /exchange/marketplace [R=301,L]
  RewriteRule ^shop$ /exchange/marketplace [R=301,L]
  RewriteRule ^equipment$ /fleet [R=301,L]
  RewriteRule ^supplier$ /exchange/suppliers [R=301,L]
  RewriteRule ^sitemap$ /sitemap.xml [R=301,L]
  RewriteRule ^(feed|rss|atom)$ /changelog [R=301,L]
  RewriteRule ^app$ /login [R=301,L]
  RewriteRule ^companies$ / [R=301,L]

  RewriteRule ^send-demo[.]php$ contact.php [L]
  RewriteRule ^favicon[.]ico$ favicon.svg [L]
  RewriteRule ^apple-touch-icon(-precomposed)?[.]png$ favicon.svg [L]
  RewriteRule ^manifest[.]json$ manifest.webmanifest [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ![.]php$ [NC]
  RewriteRule ^ spa.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(robots.txt|sitemap.xml|manifest.webmanifest|manifest.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "(manifest[.]webmanifest|manifest[.]json)$">
    Header set Content-Type "application/manifest+json"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

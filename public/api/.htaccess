# Never serve these as files. config.php holds database credentials — if the
# PHP handler is ever misconfigured or disabled, an unprotected .php file is
# served as plaintext and the password leaks. Deny at the web-server level so
# that failure mode can't happen.

<FilesMatch "^(config\.php|config\.example.php|bootstrap\.php|ops\.php|ops-schema\.php|ops-seed\.php|ops-view\.php|schema\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Auth responses must never be cached by a proxy or the browser.
<FilesMatch "\.php$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
    Header always set X-Content-Type-Options "nosniff"
  </IfModule>
</FilesMatch>

# Directory listing would expose which endpoints exist.
Options -Indexes

# index.php is LiteSpeed's default DirectoryIndex. Do not ErrorDocument 404 to
# a PHP script that itself returns 404 — that loop is an HTTP 500 on this host.
DirectoryIndex index.php
ErrorDocument 404 default

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^not-found\.php$ - [L]
  # Always send the probe to the working root /health.php. PT so LiteSpeed
  # re-runs the PHP handler on the target instead of 404ing a missing local file.
  RewriteRule ^health(\.php)?/?$ /health.php [L,PT]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ not-found.php [L]
</IfModule>
